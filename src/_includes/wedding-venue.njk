---
# Layout for a wedding venue page. The pages themselves are generated by
# src/pages/delivery/venue.njk, which paginates over weddingVenues; `venueKey` is that
# pagination's alias, and the page's title, description and headings are computed from the venue
# in src/pages/delivery/venue.11tydata.js.
layout: layout.njk
styles:
  - wedding-venue
hasCarousel: true
---
{% set venue = venues[venueKey] %}

{# Cakes made at this venue, if there are enough of them to fill a carousel; otherwise fall
   back to wedding cakes generally. Worked out once here rather than inside each carousel's
   ternary, which used to call getMatchingCakes twice per carousel. #}
{% set venueCakes = portfolio | getMatchingCakes({ venue: venueKey }) %}
{% set carouselCakes = venueCakes if venueCakes.length > 5 else (portfolio | getMatchingCakes({ product: 'wedding-cake' })) %}

<section class="intro">
    <div class="venue-intro">
        <div class="venue-image {{ "image-circle" if portfolio[venue.featuredCakes[0]].images[0].aspectRatio > 0.9 and portfolio[venue.featuredCakes[0]].images[0].aspectRatio < 1.1 }}">
            {% from "macros/picture.njk" import pictureElement with context %}
            {{ pictureElement("portfolio/" ~ portfolio[venue.featuredCakes[0]].images[0].src, "Wedding cake at " ~ venue.name, "250px") }}
        </div>
        <div class="venue-text">
            <p class="handwritten-tagline">{{ venue.tagline }}</p>

            <p class="venue-address">{{ venue.address | join(", ") }}</p>

            <a
                class="button wedding-venue-cta-button"
                href="/products/wedding-cakes"
            >
                Shop wedding cakes
            </a>
        </div>
    </div>
</section>

{% from "macros/image-carousel.njk" import imageCarousel with context %}
{{
    imageCarousel(
        carouselCakes,
        'linear-gradient(to bottom, #fff, ' ~ products.weddingCakes.colours.light ~ ')'
    )
}}

<section style="background:{{products.weddingCakes.colours.light}}">
    <div class="venue-content">
        <h2>Wedding cake inspiration for {{ venue.name }}</h2>
        <p>{{ venue.cakeStylesIntro }}</p>
        <p>Potential cake elements for the venue include:</p>
        <ul>
            {% for style in venue.popularCakeStyles %}
                <li>{{ style }}</li>
            {% endfor %}
        </ul>
        <div class="flavour-tip">
            <div class="flavour-tip-heading">
                <div class="flavour-icon">
                    {% include "svgs/lemon.svg" %}
                </div>
                <h3>Flavour tip</h3>
            </div>
            <p>{{ venue.flavourTip | safe }}</p>
            <a href="/flavours">Explore flavours</a>
        </div>

        {% set dividingImage = portfolio[venue.featuredCakes[1] if venue.featuredCakes[1] else venue.featuredCakes[0]].images[0] %}
        <div class="venue-image {{ "image-circle" if dividingImage.aspectRatio > 0.9 and dividingImage.aspectRatio < 1.1 }}">
            {{ pictureElement("portfolio/" ~ dividingImage.src, "Wedding cake at " ~ venue.name, "220px") }}
        </div>

        <h2>My experience at {{ venue.name }}</h2>
        <p>{{ venue.myExperience }}</p>

        <a
            class="button wedding-venue-cta-button"
            href="/products/wedding-cakes"
        >
            Shop wedding cakes
        </a>
    </div>
</section>

{{
    imageCarousel(
        carouselCakes,
        'linear-gradient(to bottom, #fff, #000)'
    )
}}

{% include "featured-in.njk" %}

{% include "wedding-favours.njk" %}

