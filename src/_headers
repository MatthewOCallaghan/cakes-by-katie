# Cloudflare Pages headers config — mirrors the long-lived cache-control behaviour
# previously set by .htaccess (mod_headers) on Mythic Beasts.
# https://developers.cloudflare.com/pages/configuration/headers/

/*.pdf
  Cache-Control: public, max-age=31536000
/*.avif
  Cache-Control: public, max-age=31536000
/*.webp
  Cache-Control: public, max-age=31536000
/*.js
  Cache-Control: public, max-age=31536000
/*.css
  Cache-Control: public, max-age=31536000
/*.mp4
  Cache-Control: public, max-age=31536000
