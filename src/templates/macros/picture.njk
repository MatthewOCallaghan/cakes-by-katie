{% macro pictureElement(path, alt, recommendedSizes, imageStyle) %}
<picture>
    {% set name = path | removeExtension %}
    {% for type in imageFormats.formats %}
        <source
            type="image/{{ type }}"
            srcset="{{ createSrcset("/images/" + name, type) }}"
            sizes="{{ recommendedSizes | createSizes }}"
        >
    {% endfor %}
    <img src="{{ getDefaultSrc("/images/" + name) }}" alt="{{ alt }}" style="{{ imageStyle }}" />
</picture>
{% endmacro %}