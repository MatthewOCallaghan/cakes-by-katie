---
# One page per wedding venue, rendered from src/content/venues.json. This replaced 24 two-line
# stub files and 24 entries of page metadata — adding a venue is now a single edit to
# venues.json, and the page's title, description, heading and CTA are derived from it
# (see src/_data/pages.js).
pagination:
    data: weddingVenues
    size: 1
    alias: venueKey
    # Without this Eleventy puts only the FIRST generated page into collections.all, which would
    # silently drop 24 venue pages from the generated sitemap.
    addAllPagesToCollections: true
permalink: "delivery/{{ venueKey }}.html"
---
{% set page = "venue:" ~ venueKey %}
{% extends "wedding-venue.njk" %}
